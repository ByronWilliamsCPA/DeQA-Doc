GEMINI_API_KEY=

OPENROUTER_API_KEY=

ANTHROPIC_API_KEY=

# HuggingFace Token (for dataset downloads)
# To use: huggingface-cli login --token $HF_TOKEN
# GitHub Secret: Create HF_TOKEN secret with this same value
HF_TOKEN=

# GCP Service Account Key (base64 encoded)
# To decode: echo $GCP_SA_KEY | base64 -d > service-account.json
# GitHub Secret: Update GCP_SA_KEY secret with this same base64 value
GCP_SA_KEY=

# =============================================================================
# GCS Model Artifact Storage Configuration
# =============================================================================

# GCS Bucket for RAG Pipeline Models (canonical storage)
GCS_BUCKET_NAME=

# GCP Project ID (extracted from service account)
GCP_PROJECT_ID=

# Model Storage Configuration
MODEL_PROJECT_NAME=

# Dataset version tracking (update when using new dataset versions)
DATASET_VERSION=

# Training Configuration
DEBUG=
RANDOM_SEED=

# HMAC Key
GOOGLE_ACCESS_KEY_ID=
GOOGLE_ACCESS_KEY_SECRET=

# Adobe PDF Services (for Adobe Extract OCR engine)
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=